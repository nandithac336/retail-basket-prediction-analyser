# Choose ONE provider for the optional app/llm.py chat helper.
# Copy this file to .env, uncomment/fill one provider block, and keep .env private.
# The five-milestone NumPy training/evaluation pipeline runs locally and does not
# call this chat endpoint; this setting preserves the starter's model configuration.

# 1) Local model with Ollama (install Ollama, then pull a model such as qwen2.5:3b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:3b

# 2) Groq (create a key at https://console.groq.com)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-api-key
# LLM_MODEL=llama-3.1-8b-instant

# 3) Gemini (create a key at https://aistudio.google.com)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-2.5-flash
